<tool id="tabular_data_prediction" name="Accelerated tabular data prediction" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>classification and regression with TabICL</description>
    <macros>
        <token name="@TOOL_VERSION@">2.1.1</token>
        <token name="@VERSION_SUFFIX@">1</token>
        <token name="@PROFILE@">25.1</token>
        <xml name="supervised_inputs">
            <conditional name="evaluation">
                <param name="method" type="select" label="Evaluation strategy">
                    <option value="train_test" selected="true">Train/test datasets</option>
                    <option value="cross_validation">K-fold cross validation</option>
                </param>
                <when value="train_test">
                    <param name="train_data" type="data" format="tabular" label="Training data" help="The target must be the final column."/>
                    <param name="train_header" type="boolean" truevalue="true" falsevalue="false" label="Training data has a header"/>
                    <param name="test_data" type="data" format="tabular" label="Test data"/>
                    <param name="test_header" type="boolean" truevalue="true" falsevalue="false" label="Test data has a header"/>
                    <param name="testhaslabels" type="boolean" truevalue="true" falsevalue="false" label="Test data includes the target in its final column"/>
                </when>
                <when value="cross_validation">
                    <param name="cv_data" type="data" format="tabular" label="Labelled input data"/>
                    <param name="cv_header" type="boolean" truevalue="true" falsevalue="false" label="Input has a header"/>
                    <param name="n_splits" type="integer" value="5" min="2" label="Number of folds"/>
                    <param name="cv_strategy" type="select" label="Split strategy">
                        <option value="stratified" selected="true">Stratified k-folds (classification)</option>
                        <option value="kfold">Standard k-folds</option>
                    </param>
                </when>
            </conditional>
            <conditional name="learning">
                <param name="fine_tune" type="select" label="Model adaptation">
                    <option value="false" selected="true">In-context learning</option>
                    <option value="true">Fine-tune checkpoint</option>
                </param>
                <when value="false">
    <conditional name="inference">
                    <param name="advanced_icl" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Advanced in-context learning parameters"/>
                    <when value="false"/>
                    <when value="true">
                        <param name="n_estimators" type="integer" value="8" min="1" label="Ensemble members" help="More members can improve predictions but increase runtime."/>
                        <param name="norm_methods" type="select" label="Normalization methods">
                            <option value="default" selected="true">TabICL defaults</option>
                            <option value="none">None only</option>
                            <option value="power">Power transform only</option>
                            <option value="none_power">None and power transform</option>
                        </param>
                        <param name="feat_shuffle_method" type="text" value="latin" label="Feature shuffle method"/>
                        <param name="class_shuffle_method" type="text" value="shift" label="Class shuffle method" help="Classification only."/>
                        <param name="outlier_threshold" type="float" value="4.0" min="0" label="Outlier clipping z-score threshold"/>
                        <param name="softmax_temperature" type="float" value="0.9" min="0" label="Softmax temperature" help="Classification only."/>
                        <param name="average_logits" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Average logits" help="Classification only; otherwise probabilities are averaged."/>
                        <param name="support_many_classes" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Support more than 10 classes" help="Classification only."/>
                        <param name="batch_size" type="integer" value="8" min="1" label="Ensemble batch size"/>
                        <param name="kv_cache" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Use KV cache" help="Speeds repeated predictions at the cost of memory."/>
                        <param name="allow_auto_download" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Allow automatic checkpoint download"/>
                        <param name="checkpoint_version" type="text" value="" optional="true" label="Checkpoint version" help="Leave empty when using the selected installed model."/>
                        <param name="device" type="text" value="auto" label="Device" help="auto, cpu, cuda, cuda:0, or mps."/>
                        <param name="use_amp" type="select" label="Automatic mixed precision">
                            <option value="auto" selected="true">Auto</option>
                            <option value="true">Enabled</option>
                            <option value="false">Disabled</option>
                        </param>
                        <param name="use_fa3" type="select" label="Flash Attention 3">
                            <option value="auto" selected="true">Auto</option>
                            <option value="true">Enabled</option>
                            <option value="false">Disabled</option>
                        </param>
                        <param name="offload_mode" type="text" value="auto" label="Offload mode"/>
                        <param name="disk_offload_dir" type="text" value="" optional="true" label="Disk offload directory"/>
                        <param name="random_state" type="integer" value="42" label="Random seed"/>
                        <param name="n_jobs" type="integer" value="0" min="0" label="CPU threads" help="0 lets TabICL choose."/>
                        <param name="verbose" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Verbose inference logging"/>
                        <param name="inference_config" type="text" value="" optional="true" label="Fine-grained inference configuration (JSON)"/>
                    </when>
                </conditional>
                </when>
                <when value="true">
                    <param name="epochs" type="integer" value="50" min="1" label="Maximum epochs"/>
                    <param name="learning_rate" type="float" value="0.00001" min="0" label="Learning rate"/>
                    <param name="n_estimators_finetune" type="integer" value="2" min="1" label="Fine-tuning estimators"/>
                    <param name="n_estimators_validation" type="integer" value="2" min="1" label="Validation estimators"/>
                    <param name="n_estimators_inference" type="integer" value="8" min="1" label="Inference estimators"/>
                    <param name="validation_fraction" type="float" value="0.2" min="0.01" max="0.5" label="Validation fraction"/>
                    <param name="early_stopping" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Use early stopping"/>
                    <param name="patience" type="integer" value="10" min="1" label="Early-stopping patience"/>
                    <param name="eval_metric" type="select" label="Validation metric">
                        <option value="accuracy" selected="true">Accuracy (classification)</option>
                        <option value="roc_auc">ROC AUC (classification)</option>
                        <option value="log_loss">Log loss (classification)</option>
                        <option value="mse">MSE (regression)</option>
                        <option value="mae">MAE (regression)</option>
                        <option value="r2">R2 (regression)</option>
                    </param>
                </when>
            </conditional>
            <conditional name="explain">
                <param name="shap" type="boolean" truevalue="true" falsevalue="false" checked="false" label="SHAP explanation" help="Create a SHAP summary plot."/>
                <when value="false"/>
                <when value="true">
                    <param name="shap_max_samples" type="integer" value="10" min="1" label="Maximum samples to explain"/>
                </when>
            </conditional>
        </xml>
    </macros>
    <creator>
        <organization name="European Galaxy Team" url="https://galaxyproject.org/eu/"/>
        <person givenName="Anup" familyName="Kumar" email="kumara@informatik.uni-freiburg.de"/>
    </creator>
    <requirements>
        <container type="docker">docker-tabular:latest</container>
    </requirements>
    <command detect_errors="aggressive"><![CDATA[
        python '$__tool_directory__/main.py'
            --selected_task '$task.selected_task'
            --model_path '$model_source.pretrained_model'
            #if str($task.selected_task) in ('Classification', 'Regression')
                --evaluation_method '$task.evaluation.method'
                #if str($task.evaluation.method) == 'train_test'
                    --train_data '$task.evaluation.train_data'
                    --train_header '$task.evaluation.train_header'
                    --test_data '$task.evaluation.test_data'
                    --test_header '$task.evaluation.test_header'
                    --testhaslabels '$task.evaluation.testhaslabels'
                #else
                    --train_data '$task.evaluation.cv_data'
                    --train_header '$task.evaluation.cv_header'
                    --n_splits '$task.evaluation.n_splits'
                    --cv_strategy '$task.evaluation.cv_strategy'
                #end if
                --fine_tune '$task.learning.fine_tune'
                #if str($task.learning.fine_tune) == 'false'
                    --advanced_icl '$task.learning.inference.advanced_icl'
                    #if str($task.learning.inference.advanced_icl) == 'true'
                        --n_estimators '$task.learning.inference.n_estimators'
                        --norm_methods '$task.learning.inference.norm_methods'
                        --feat_shuffle_method '$task.learning.inference.feat_shuffle_method'
                        --class_shuffle_method '$task.learning.inference.class_shuffle_method'
                        --outlier_threshold '$task.learning.inference.outlier_threshold'
                        --softmax_temperature '$task.learning.inference.softmax_temperature'
                        --average_logits '$task.learning.inference.average_logits'
                        --support_many_classes '$task.learning.inference.support_many_classes'
                        --batch_size '$task.learning.inference.batch_size'
                        --kv_cache '$task.learning.inference.kv_cache'
                        --allow_auto_download '$task.learning.inference.allow_auto_download'
                        --checkpoint_version '$task.learning.inference.checkpoint_version'
                        --device '$task.learning.inference.device'
                        --use_amp '$task.learning.inference.use_amp'
                        --use_fa3 '$task.learning.inference.use_fa3'
                        --offload_mode '$task.learning.inference.offload_mode'
                        --disk_offload_dir '$task.learning.inference.disk_offload_dir'
                        --random_state '$task.learning.inference.random_state'
                        --n_jobs '$task.learning.inference.n_jobs'
                        --verbose '$task.learning.inference.verbose'
                        --inference_config '$task.learning.inference.inference_config'
                    #end if
                #end if
                #if str($task.learning.fine_tune) == 'true'
                    --epochs '$task.learning.epochs'
                    --learning_rate '$task.learning.learning_rate'
                    --n_estimators_finetune '$task.learning.n_estimators_finetune'
                    --n_estimators_validation '$task.learning.n_estimators_validation'
                    --n_estimators_inference '$task.learning.n_estimators_inference'
                    --early_stopping '$task.learning.early_stopping'
                    --patience '$task.learning.patience'
                    --eval_metric '$task.learning.eval_metric'
                    --validation_fraction '$task.learning.validation_fraction'
                #end if
                --shap '$task.explain.shap'
                #if str($task.explain.shap) == 'true'
                    --shap_max_samples '$task.explain.shap_max_samples'
                #end if
            #end if
    ]]></command>
    <inputs>
        <conditional name="model_source">
            <param name="source_type" type="select" label="Pretrained model source">
                <option value="preinstalled">Use an installed model</option>
            </param>
            <when value="preinstalled">
                <param name="pretrained_model" type="select" label="Select the task-compatible TabICL checkpoint">
                    <options from_data_table="huggingface">
                        <column name="name" index="1"/>
                        <column name="value" index="6"/>
                        <filter type="static_value" value="tabicl" column="4"/>
                        <filter type="static_value" value="1" column="5"/>
                    </options>
                    <validator type="no_options" message="No TabICL models are installed on this Galaxy instance."/>
                </param>
            </when>
        </conditional>
        <conditional name="task">
            <param name="selected_task" type="select" label="Machine learning task">
                <option value="Classification" selected="true"/>
                <option value="Regression"/>
            </param>
            <when value="Classification">
                <expand macro="supervised_inputs"/>
            </when>
            <when value="Regression">
                <expand macro="supervised_inputs"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data format="tabular" name="output_predicted_data" from_work_dir="output_predicted_data" label="${tool.name}: result"/>
        <data format="png" name="output_plot" from_work_dir="output_plot.png" label="${tool.name}: prediction plot">
            <filter>(task['selected_task'] in ['Classification', 'Regression'] and task['evaluation']['method'] == 'train_test' and task['evaluation']['testhaslabels'] is True)</filter>
        </data>
        <data format="tabular" name="cv_metrics" from_work_dir="cv_metrics.tsv" label="${tool.name}: cross-validation metrics">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['evaluation']['method'] == 'cross_validation'</filter>
        </data>
        <data format="png" name="shap_plot" from_work_dir="shap_plot.png" label="${tool.name}: SHAP summary">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['explain']['shap'] is True</filter>
        </data>
        <data format="binary" name="finetuned_model" from_work_dir="finetuned_model/best.ckpt" label="${tool.name}: fine-tuned checkpoint">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['learning']['fine_tune'] == 'true'</filter>
        </data>
    </outputs>
    <help><![CDATA[
**What it does**

Runs TabICL classification and regression. Classification and regression can optionally fine-tune the selected checkpoint and produce SHAP explanations.

Supervised input uses the final column as the target. Enable **Advanced in-context learning parameters** to configure ensembling, normalization, shuffling, caching, acceleration, offloading, devices, and fine-grained inference. These settings apply when **In-context learning** is selected; fine-tuning has its own training and inference controls.
    ]]></help>
    <citations>
        <citation type="doi">10.48550/arXiv.2502.05564</citation>
    </citations>
</tool>
